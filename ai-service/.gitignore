# Python virtual environment
.venv/
venv/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environment files
.env
.env.*
!.env.example

# Models directory: include trained model weights and metadata
!models/*.pth
!models/*.joblib
!models/*.json
!models/.gitkeep

# Datasets directory: include operational datasets under GitHub 100MB limit
!datasets/**/*.gitkeep
!datasets/**/*.json
!datasets/**/*.csv
!datasets/**/*.jpg

# Large dataset files exceeding GitHub 100MB file limit (1.63GB and 573MB)
datasets/price/price_trends.sqlite
datasets/price/agriconnect_prices_2025_clean.csv

# Temporary & uploaded files
temp/
uploads/
*.tmp
