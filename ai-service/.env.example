APP_NAME=AgriConnect AI Service
APP_VERSION=1.0.0
APP_ENV=development
AI_HOST=127.0.0.1
AI_PORT=8000
AI_API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
MODEL_DIR=models
DATASET_DIR=datasets
MAX_UPLOAD_SIZE_MB=10
# Optional custom path for Render persistent disk (e.g. /var/data/price_trends.sqlite)
PRICE_TRENDS_DB_PATH=
# Optional download URL to fetch price_trends.sqlite during deployment build
PRICE_TRENDS_DOWNLOAD_URL=
